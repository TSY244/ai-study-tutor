:8080 {
	encode zstd gzip

	@unexpectedHost not host localhost 127.0.0.1
	respond @unexpectedHost 421

	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:8080} {
			flush_interval -1
		}
	}

	handle /healthz {
		reverse_proxy {$API_UPSTREAM:api:8080}
	}

	handle /readyz {
		reverse_proxy {$API_UPSTREAM:api:8080}
	}

	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv
		try_files {path} /index.html
		header Cache-Control "no-store"
		file_server
	}

	header {
		Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: blob:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		-Server
	}
}
