  "notes": [
    "多选按规范化后的字符串逐项比较：不去重、不排序，顺序或重复不同即判错（legacy 现状，golden 如实冻结）。",
    "03-backend-architecture.md §10.2 的目标行为（多选集合比较）与旧实现不同，B4 迁移时必须显式决策并记录。",
    "short_answer/case_analysis 恒为 False：需要 AI 批阅，本地不判分。"
  ],
  "normalize": {
    "function": "normalize_objective_answer(value)",
    "cases": [
      {
        "name": "single_letter_upper",
        "input": "a",
        "expect": "A"
      },
      {
        "name": "surrounding_whitespace",
        "input": "  b  ",
        "expect": "B"
      },
      {
        "name": "chinese_comma",
        "input": "a，b",
        "expect": "A,B"
      },
      {
        "name": "mixed_separators_and_case",
        "input": "a, b ,C",
        "expect": "A,B,C"
      },
      {
        "name": "empty_string",
        "input": "",
        "expect": ""
      },
      {
        "name": "only_separators",
        "input": "，, ，",
        "expect": ""
      },
      {
        "name": "multi_letter_token",
        "input": "ab",
        "expect": "AB"
      },
      {
        "name": "empty_segments_dropped",
        "input": "a,,b,",
        "expect": "A,B"
      },
      {
        "name": "chinese_boolean_untouched",
        "input": "对",
        "expect": "对"
      },
      {
        "name": "already_normalized",
        "input": "A,B,C",
        "expect": "A,B,C"
      }
    ]
  },
