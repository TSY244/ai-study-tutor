  "weighted_mastery": {
    "function": "compute_mastery(scores)",
    "float_compare": "JSON 保存完整双精度；跨语言比较建议使用 1e-12 绝对容差。",
    "cases": [
      {
        "name": "empty_history",
        "input": {
          "scores": []
        },
        "expect": 0.0
      },
      {
        "name": "single_perfect_score",
        "input": {
          "scores": [
            {
              "score": 10,
              "total": 10,
              "timestamp": "2026-01-01"
            }
          ]
        },
        "expect": 1.0
      },
      {
        "name": "single_zero_score",
        "input": {
          "scores": [
            {
              "score": 0,
              "total": 10,
              "timestamp": "2026-01-01"
            }
          ]
        },
        "expect": 0.0
      },
      {
        "name": "recent_scores_weighted_heavier",
        "input": {
          "scores": [
            {
              "score": 0,
              "total": 10,
              "timestamp": "2026-01-01"
            },
            {
              "score": 10,
              "total": 10,
              "timestamp": "2026-01-03"
            },
            {
              "score": 10,
              "total": 10,
              "timestamp": "2026-01-02"
            }
          ]
        },
        "expect": 0.7777777777777778
      },
      {
        "name": "zero_total_records_skipped",
        "input": {
          "scores": [
            {
              "score": 5,
              "total": 0,
              "timestamp": "2026-01-01"
            },
            {
              "score": 10,
              "total": 10,
              "timestamp": "2026-01-02"
            }
          ]
        },
        "expect": 1.0
      },
      {
        "name": "all_zero_totals_yield_zero",
        "input": {
          "scores": [
            {
              "score": 5,
              "total": 0,
              "timestamp": "2026-01-01"
            },
            {
              "score": 3,
              "total": 0,
              "timestamp": "2026-01-02"
            }
          ]
        },
        "expect": 0.0
      },
      {
        "name": "missing_timestamp_sorts_first",
        "input": {
          "scores": [
            {
              "score": 6,
              "total": 10
            },
            {
              "score": 8,
              "total": 10,
              "timestamp": "2026-01-01"
            }
          ]
        },
        "expect": 0.7200000000000001
      },
      {
        "name": "fractional_scores",
        "input": {
          "scores": [
            {
              "score": 7.5,
              "total": 10,
              "timestamp": "2026-01-01"
            },
            {
              "score": 8.5,
              "total": 12,
              "timestamp": "2026-01-02"
            },
            {
              "score": 3,
              "total": 6,
              "timestamp": "2026-01-03"
            }
          ]
        },
        "expect": 0.625
      }
    ]
  },
  "detect_complexity": {
    "function": "exam_logic._detect_complexity(raw_text, lesson_text)",
    "cases": [
      {
        "name": "simple_short_plain_text",
        "input": {
          "raw_text": "本课介绍函数极限的直观含义：当自变量接近某个值时，函数值呈现的变化趋势。",
          "lesson_text": "极限描述趋势。"
        },
        "expect": "simple"
      },
      {
        "name": "normal_method_and_concept_text",
        "input": {
          "raw_text": "本课讲解求极限的常用方法与步骤。首先介绍代入法，然后介绍因式分解法，接着讨论有理化方法。",
          "lesson_text": "极限的概念与连续的定义是本课重点。"
        },
        "expect": "normal"
      },
      {
        "name": "complex_proof_and_math_text",
        "input": {
          "raw_text": "本课给出极限的严格定义，包含 ε-δ 推导与证明。涉及重要公式与定理，需要计算与微分、积分基础。",
          "lesson_text": "定理的证明与公式的推导是难点。"
        },
        "expect": "complex"
      }
    ]
  }
