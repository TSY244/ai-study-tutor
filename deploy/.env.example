APP_VERSION=local
APP_PORT=8080
APP_ENV=production
LOG_LEVEL=info

POSTGRES_DB=ai_study_tutor
POSTGRES_USER=ai_study_tutor

# Use fake only for local deployment drills. Production-like local runs use
# anthropic and read the Worker-only Docker secret.
AI_PROVIDER=anthropic
# Anthropic-compatible API base URL. For a compatible gateway, set its base
# URL here; Worker will call <base>/v1/messages.
ANTHROPIC_BASE_URL=https://api.anthropic.com
CLAUDE_MODEL_DEFAULT=
CLAUDE_REQUEST_TIMEOUT=300s
CLAUDE_MAX_OUTPUT_TOKENS=8192

WORKER_CONCURRENCY=1
WORKER_JOB_TIMEOUT=4h
JOB_LEASE_DURATION=60s
MAINTENANCE_LEASE_DURATION=45s
MAINTENANCE_HEARTBEAT_INTERVAL=10s
MAX_UPLOAD_BYTES=2147483648
MAX_DOWNLOAD_BYTES=2147483648
# Exact domains or parent domains, comma-separated. Subdomains are allowed.
URL_ALLOWLIST=youtube.com,bilibili.com
# The standard API container has no egress; Worker performs mandatory DNS and
# redirect-chain validation immediately before fetching remote material.
URL_API_DNS_VALIDATION=false
TRANSCRIPTION_MODE=whisper_local
WHISPER_MODEL_PATH=/opt/whisper/models/ggml-base.bin

# Local paths are used only by one-shot Tools containers. Runtime application
# data remains in the named app_data volume so upgrades preserve existing data.
BACKUP_DIR=../backups
LEGACY_SOURCE_DIR=../legacy-data
IMPORT_REPORT_DIR=../import-reports
TOOLS_UID=10001
TOOLS_GID=10001

# Claude multi-key gateway config directory (holds keys.json, managed from the
# Settings page). Bind-mounted into the api and worker containers only; the
# web container never sees it. Created with 0700 by deploy/scripts/init.sh.
CLAUDE_GATEWAY_CONFIG_DIR=../data/claude-gateway

# Site login cookie directory (holds bilibili.txt, managed from the Settings
# page "B 站 Cookie" section). Mounted read-write into api and read-only into
# worker; the web container never sees it. Created with 0700 by init.sh.
COOKIES_CONFIG_DIR=../data/cookies
