APP_VERSION=local
APP_PORT=8080
APP_ENV=production
LOG_LEVEL=info

POSTGRES_DB=ai_study_tutor
POSTGRES_USER=ai_study_tutor

# Use fake only for local deployment drills. Production-like local runs use
# anthropic and read the Worker-only Docker secret.
AI_PROVIDER=anthropic
CLAUDE_MODEL_DEFAULT=
CLAUDE_REQUEST_TIMEOUT=300s
CLAUDE_MAX_OUTPUT_TOKENS=8192

WORKER_CONCURRENCY=1
WORKER_JOB_TIMEOUT=30m
JOB_LEASE_DURATION=60s
MAINTENANCE_LEASE_DURATION=45s
MAINTENANCE_HEARTBEAT_INTERVAL=10s
MAX_UPLOAD_BYTES=2147483648
MAX_DOWNLOAD_BYTES=2147483648
TRANSCRIPTION_MODE=subtitle_only
WHISPER_MODEL_PATH=

# Local paths are used only by one-shot Tools containers. Runtime application
# data remains in the named app_data volume so upgrades preserve existing data.
BACKUP_DIR=../backups
LEGACY_SOURCE_DIR=../legacy-data
IMPORT_REPORT_DIR=../import-reports
TOOLS_UID=10001
TOOLS_GID=10001
