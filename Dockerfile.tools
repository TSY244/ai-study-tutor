FROM golang:1.25-alpine AS build

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY cmd ./cmd
COPY internal ./internal

RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/backup ./cmd/backup \
	&& CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/restore ./cmd/restore \
	&& CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/doctor ./cmd/doctor \
	&& CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/legacy-import ./cmd/legacy-import \
	&& CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/seed ./cmd/seed

FROM alpine:3.22 AS runtime

# PostgreSQL 17 client matches the database service. The image is only used by
# one-shot local maintenance commands; no HTTP service or Anthropic client is
# present here.
RUN apk add --no-cache ca-certificates postgresql17-client tar zstd \
	&& addgroup -g 10001 app \
	&& adduser -D -H -u 10001 -G app app \
	&& mkdir -p /var/lib/ai-study-tutor /backups /reports \
	&& chown -R 10001:10001 /var/lib/ai-study-tutor /backups /reports

COPY --from=build --chown=10001:10001 /out/ /app/

USER 10001:10001

ENTRYPOINT ["/app/backup"]
