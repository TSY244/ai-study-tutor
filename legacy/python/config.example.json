{
  "agent_command": "claude",
  "ai_config": {
    "default_provider": "openai_compat",
    "providers": {
      "openai_compat": {
        "api_key": "set-via-OPENAI_API_KEY-or-private-config",
        "base_url": "https://api.openai.com/v1",
        "model": "replace-with-supported-model"
      }
    },
    "max_token": 4096
  },
  "default_course_path": "../../legacy-data/course",
  "score_rule": {
    "choice": 2,
    "judge": 1,
    "short_answer": 5
  },
  "download_sub_only": true
}
